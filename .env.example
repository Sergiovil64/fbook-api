# Variables requeridas por push-to-ecr.sh
# Copiar a .env y completar con los outputs del CDK

ECR_REGISTRY=<account-id>.dkr.ecr.<region>.amazonaws.com
AWS_REGION=us-east-1
IMAGE_TAG=latest
ECS_CLUSTER=fbook-cluster

# Cognito — outputs del stack FbookCognitoStack (cdk deploy)
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=<UserPoolClientId output>
