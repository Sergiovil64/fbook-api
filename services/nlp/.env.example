# ============================================================
# Variables de entorno — Fbook NLP Service
# Copiar este archivo como .env y ajustar los valores localmente
# ============================================================

# Ruta al modelo fastText LID dentro del contenedor
# En producción (ECS) se usa el valor por defecto (/app/lid.176.ftz)
FASTTEXT_MODEL_PATH=/app/lid.176.ftz

# Nombre del modelo de traducción en HuggingFace Hub
# Se puede cambiar en el futuro si se quiere usar un modelo más grande
MODELO_TRADUCCION=Helsinki-NLP/opus-mt-es-en

# Directorio donde HuggingFace almacena en caché los modelos descargados
# En producción (ECS) se usa el valor por defecto (/app/model_cache)
TRANSFORMERS_CACHE=/app/model_cache

# Puerto en el que escucha el servicio (ECS usa 8000)
PORT=8000
